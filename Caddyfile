# Reverse proxy HTTPS (certificats Let's Encrypt automatiques).
# DOMAIN vient de .env (ex. aistudiophoto.com) ; le DNS A/AAAA de DOMAIN et www.DOMAIN
# doit pointer vers le VPS, ports 80 et 443 ouverts.

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# Caddy remplace X-Forwarded-For par l'IP réelle du client (en-têtes entrants ignorés),
	# d'où NUXT_TRUST_PROXY=true côté Nuxt pour la limite du chatbot.
	reverse_proxy frontend:3000

	# Assets Nuxt fingerprintés : cache long
	@assets path /_nuxt/* /_fonts/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format console
	}
}
