# Dev : copier en frontend/.env (lu par nuxt dev et docker-compose.yml)

# URL publique du site — canonicals et sitemap
# Dev  : http://localhost:3000
# Prod : https://aistudiophoto.com
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Chatbot support (server/api/ask.post.ts) ───────────────────────────────
# Clé OpenAI (serveur uniquement, jamais exposée au navigateur).
# Fixer aussi une limite de budget mensuelle sur le projet OpenAI.
NUXT_OPENAI_API_KEY=sk-...
# Vector store contenant la doc support (platform.openai.com/storage/vector_stores)
NUXT_OPENAI_VECTOR_STORE_ID=vs_...
# Optionnel — défauts : gpt-4.1-mini / 500 questions par jour (tous visiteurs)
# NUXT_OPENAI_MODEL=gpt-4.1-mini
# NUXT_CHAT_DAILY_LIMIT=500
# true uniquement derrière un reverse proxy qui réécrit X-Forwarded-For
# NUXT_TRUST_PROXY=false
