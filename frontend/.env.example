# Dev : copier en frontend/.env (lu par nuxt dev et docker-compose.yml)

# URL publique du site — canonicals et sitemap
# Dev  : http://localhost:3000
# Prod : https://glintstudio.ai
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Chatbot support (frontend/server/api/ask.post.ts) ──────────────────────
# Clé API Anthropic (serveur uniquement, jamais exposée au navigateur) — console.anthropic.com
# Prod : clé dédiée à la vitrine, dans un workspace dédié avec une limite de dépense mensuelle (ex. 5 $) :
# c'est le vrai plafond, les compteurs ci-dessous sont en mémoire et repartent de zéro à chaque redémarrage.
NUXT_ANTHROPIC_API_KEY=sk-ant-...
# Optionnel — défauts : claude-haiku-4-5 (modèle Haiku uniquement, sinon défaut) /
# 200 questions par jour UTC et 1000 par mois UTC, tous visiteurs confondus (0 = chatbot coupé).
# Fixes dans le code : 15 questions/min et 30/h par IP, question ≤ 1000 caractères, réponse ≤ 400 tokens.
# NUXT_ANTHROPIC_MODEL=claude-haiku-4-5
# NUXT_CHAT_DAILY_LIMIT=200
# NUXT_CHAT_MONTHLY_LIMIT=1000
# La documentation utilisée par le chatbot : frontend/server/assets/support-docs.md
# true uniquement derrière un reverse proxy qui réécrit X-Forwarded-For
# NUXT_TRUST_PROXY=false
