{
  "name": "frontend",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm run build"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^7.6.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.139",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "vue-tsc": "^3.3.12"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
