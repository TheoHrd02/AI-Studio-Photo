{
  "name": "frontend",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/image": "1.11.0",
    "@nuxt/ui": "4.0.1",
    "@pinia/nuxt": "^0.11.2",
    "@vueuse/core": "^14.2.1",
    "nuxt": "^4.1.3",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.6.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.1",
    "@vueuse/nuxt": "^14.2.1",
    "eslint": "^10.0.1",
    "vue-tsc": "^3.2.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.1"
    }
