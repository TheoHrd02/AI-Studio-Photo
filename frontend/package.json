{
  "name": "frontend",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm run build"
  },
  "dependencies": {
    "@nuxt/image": "1.11.0",
    "@nuxt/ui": "4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^7.6.0",
    "nuxt": "^4.3.1",
    "nuxt-site-config": "^3.2.20",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.6.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.0.1",
    "vue-tsc": "^3.2.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
