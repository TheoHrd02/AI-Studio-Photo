# ─── Stage 1: Build ─────────────────────────────────────────────────────────
FROM node:24-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Site URL baked at build (sitemap/canonicals); other NUXT_* vars are read at runtime
ARG NUXT_PUBLIC_SITE_URL
ENV NUXT_PUBLIC_SITE_URL=${NUXT_PUBLIC_SITE_URL}

RUN pnpm run build

# ─── Stage 2: Runtime ───────────────────────────────────────────────────────
FROM node:24-alpine AS runtime

WORKDIR /app

# Copy built output only (no dev deps, no source)
COPY --from=builder --chown=node:node /app/.output ./.output
# Nuxt Content restores its SQLite DB here on first request
RUN mkdir .data && chown node:node .data
USER node

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

EXPOSE 3000

# NUXT_* env vars override runtimeConfig when container starts
CMD ["node", ".output/server/index.mjs"]
