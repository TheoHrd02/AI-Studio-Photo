# Production (VPS) : copier en .env à la racine — lu par docker-compose.prod.yml

# Domaine public, sans https:// (DNS de DOMAIN et www.DOMAIN -> IP du VPS)
DOMAIN=glintstudio.ai

# ─── Chatbot support (frontend/server/api/ask.post.ts) ──────────────────────
# Clé API Anthropic (serveur uniquement, jamais exposée au navigateur) — console.anthropic.com
# Fixer aussi une limite de dépense mensuelle dans la console Anthropic.
NUXT_ANTHROPIC_API_KEY=sk-ant-...
# Optionnel — défauts : claude-haiku-4-5 / 500 questions par jour (tous visiteurs)
# NUXT_ANTHROPIC_MODEL=claude-haiku-4-5
# NUXT_CHAT_DAILY_LIMIT=500
# La documentation utilisée par le chatbot : frontend/server/assets/support-docs.md
