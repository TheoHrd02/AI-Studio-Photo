# Production environment — copy to .env and fill values
# cp .env.example.prod .env

# ─── Frontend (client + server) ─────────────────────────────────────────────
# URL the browser uses to call the API (same-origin or CORS)
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# URL the frontend server uses to proxy/call backend (internal)
NUXT_GO_API_URL=http://backend:8080/api/v1

# Optional
NUXT_PUBLIC_SITE_URL=https://aistudiophoto.com

# ─── Backend ────────────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=release
CORS_ORIGINS=https://aistudiophoto.com,https://www.aistudiophoto.com

# OpenAI (Chatbot)
OPENAI_API_KEY=sk-your-key
ASSISTANT_ID=asst_your_id
